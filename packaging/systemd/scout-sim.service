# SIMULATION ONLY: sea (current, wind), sky (sun, cloud) and Scout's power
# system around SITL. Feeds BATTERY_STATUS to scout-lowpower's power link.
# Shipped in the scout-sim deb, which also puts the boat units on the
# simulated clock (drop-ins reading /etc/scout/sim.env).
[Unit]
Description=Scout simulation: environment and power system around SITL
After=scout-sitl.service
Wants=scout-sitl.service
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=-/etc/scout/scout.env
EnvironmentFile=-/etc/scout/sim.env
ExecStart=/usr/bin/scout-sim run --arm --truth /var/lib/scout-sim/sim-truth.jsonl
User=scout
Group=scout
StateDirectory=scout-sim
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
