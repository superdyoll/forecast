# /etc/scout/scout.env: read by every scout-* systemd unit and by the
# scout-lowpower command. KEY=value, one per line. Shipped by the scout-lowpower
# deb as a conffile: apt keeps your edits across upgrades.

# Autopilot link. On the boat e.g. serial:/dev/ttyACM0:115200; SITL: tcp:127.0.0.1:5760
SCOUT_MAVLINK=tcp:127.0.0.1:5760
# Where BATTERY_STATUS (battery, load, solar) comes from if not via the
# autopilot link. Leave empty if the autopilot reports them.
SCOUT_POWER_LINK=udpin:127.0.0.1:14601
# Energy model. The package installs the 17-day fit here; replace it with a
# newer scout-evaluate params.json if you have one (apt keeps your copy).
SCOUT_PARAMS=/etc/scout/params.json
# Relay that powers Starlink, if the service may switch it (it then also knows
# when Starlink was on, which sharpens its current estimate). Unset: no relay.
#SCOUT_STARLINK_RELAY=1

# Advisory mode, for a first boat: decide, forecast and log (journald, web
# page) but send the autopilot nothing. Unset or 0: the service is in control.
#SCOUT_DRY_RUN=1

# Web page. 127.0.0.1 = this machine only; there is no authentication.
SCOUT_WEB_HOST=127.0.0.1
SCOUT_WEB_PORT=8080
# Optional: telemetry CSV for "forecast a past period" on the web page.
#SCOUT_TELEMETRY_CSV=/srv/scout/scout_telemetry_2025-07.csv

# Simulation settings (SCOUT_CLOCK, SCOUT_SIM_*) live in /etc/scout/sim.env,
# which the scout-sim deb creates. Never install scout-sim on the boat.
