# /etc/scout/scout.env: read by every scout-* systemd unit and by the
# /usr/local/bin/scout-lowpower wrapper. KEY=value, one per line.

# Autopilot link. On the boat e.g. serial:/dev/ttyACM0:115200; SITL: tcp:127.0.0.1:5760
SCOUT_MAVLINK=tcp:127.0.0.1:5760
# Where BATTERY_STATUS (battery, load, solar) comes from if not via the
# autopilot link. Leave empty if the autopilot reports them.
SCOUT_POWER_LINK=udpin:127.0.0.1:14601
# Energy model fitted by scout-evaluate (install.sh --params puts it here).
SCOUT_PARAMS=/etc/scout/params.json

# Web page. 127.0.0.1 = this machine only; there is no authentication.
SCOUT_WEB_HOST=127.0.0.1
SCOUT_WEB_PORT=8080
# Optional: telemetry CSV for "forecast a past period" on the web page.
#SCOUT_TELEMETRY_CSV=/srv/scout/scout_telemetry_2025-07.csv

# --- Simulation only (install.sh --with-sim fills these in) ---
#SCOUT_CLOCK=
#SCOUT_SIM_SITL=tcp:127.0.0.1:5762
#SCOUT_SIM_POWER_OUT=udpout:127.0.0.1:14601
