# A throwaway Debian with systemd as PID 1, for testing the debs and their
# units (packaging/test/smoke.sh). No python3 or adduser: installing the debs
# must pull those in as dependencies.
FROM debian:bookworm
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      systemd systemd-sysv dbus curl ca-certificates procps \
    && rm -rf /var/lib/apt/lists/*
# IMPORTANT: this container runs privileged and shares the Docker VM's kernel.
# systemd-binfmt would clear the VM's binfmt_misc handlers at boot, which
# removes Docker Desktop's x86-64 emulation for every other container (the
# amd64 SITL image then fails with "exec format error"). Never let it run.
RUN systemctl mask systemd-binfmt.service proc-sys-fs-binfmt_misc.automount \
      proc-sys-fs-binfmt_misc.mount
STOPSIGNAL SIGRTMIN+3
CMD ["/lib/systemd/systemd"]
