[flake8]
# Match black's line length and ignore the checks black disagrees with.
max-line-length = 88
extend-ignore = E203, E701, E704
exclude = .git, __pycache__, .venv, data
# The MAVLink message table mirrors the XML definitions one message per line.
per-file-ignores =
    apps/lowpower/src/scout_lowpower/mavlink.py: E501
