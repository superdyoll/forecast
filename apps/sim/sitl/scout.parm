# Scout overrides on top of ArduPilot's rover.parm + sailboat-motor.parm (SITL only).
# Power comes from scout-sim's model, not SITL's toy battery.
BATT_MONITOR 0
# Wind is applied by scout-sim as hull leeway through SIM_TIDE_*; no sail forces.
SIM_WIND_SPD 0
SAIL_ENABLE 0
# SITL has no RC transmitter or safety switch.
ARMING_CHECK 0
FS_THR_ENABLE 0
FS_GCS_ENABLE 0
# Cruise speed and throttle feed-forward for the SITL hull model. Its motor
# gives 0.1 N per us of PWM above 1500 against ~0.5 v^2 of drag: ~0.93 m/s at
# 1 % throttle, 1.8 m/s at 4 % (measured in still water). Scout's whole speed
# range is under 1 % (a few us of PWM), so SITL holds it only coarsely.
CRUISE_SPEED 0.9
CRUISE_THROTTLE 1
WP_SPEED 0.6
WP_RADIUS 15
LOIT_RADIUS 50
